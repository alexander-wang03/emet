{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Emet events, major version 1",
  "description": "One record of the file emet-listen and emet-talk write with --events: the header first, then one wake record for each line --stats prints under a wake, one turn record for each per-turn line, and one footer record. Numbers and verdicts only, never a word anybody said (decision N138). Every key of version 1.0 is required. A minor version may add keys, kinds and values, and this file is updated with it; a reader ignores a key it does not know and skips a kind it does not know. Every *_ms is whole milliseconds except the four frame_*_ms; every *_s has at most three decimals; a missing value is null.",
  "oneOf": [
    {"$ref": "#/$defs/header"},
    {"$ref": "#/$defs/wake"},
    {"$ref": "#/$defs/turn"},
    {"$ref": "#/$defs/footer"}
  ],

  "$defs": {
    "count": {"type": "integer", "minimum": 0},
    "ms": {"type": ["integer", "null"]},
    "seconds": {"type": "number", "minimum": 0},
    "host": {"type": ["string", "null"], "minLength": 1},

    "latency": {
      "description": "One footer latency: its mean, its largest and how many turns measured it, or null when none did.",
      "type": ["object", "null"],
      "required": ["mean_ms", "max_ms", "n"],
      "properties": {
        "mean_ms": {"type": "integer"},
        "max_ms": {"type": "integer"},
        "n": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": true
    },

    "reading": {
      "description": "One board reading, each part null where the platform cannot read it.",
      "type": "object",
      "required": ["temp_c", "throttled", "load"],
      "properties": {
        "temp_c": {"type": ["number", "null"]},
        "throttled": {"type": ["integer", "null"], "minimum": 0},
        "load": {
          "type": ["array", "null"],
          "items": {"type": "number", "minimum": 0},
          "minItems": 3,
          "maxItems": 3
        }
      },
      "additionalProperties": true
    },

    "sent": {
      "description": "What one stage sent to one host off the body: seconds of audio from the transcriber, characters from the language model and the voice.",
      "type": "object",
      "required": ["stage", "host"],
      "properties": {
        "stage": {"enum": ["stt", "llm", "voice"]},
        "host": {"type": "string", "minLength": 1},
        "audio_s": {"type": "number", "exclusiveMinimum": 0},
        "chars": {"type": "integer", "exclusiveMinimum": 0}
      },
      "if": {"properties": {"stage": {"const": "stt"}}},
      "then": {"required": ["audio_s"]},
      "else": {"required": ["chars"]},
      "additionalProperties": true
    },

    "header": {
      "description": "The first line: what wrote the file.",
      "type": "object",
      "required": ["format", "version", "program", "packages", "platform", "python"],
      "properties": {
        "format": {"const": "emet-events"},
        "version": {"type": "string", "pattern": "^1\\.[0-9]+$"},
        "program": {"enum": ["emet-listen", "emet-talk"]},
        "packages": {
          "type": "object",
          "required": ["emet-sdk", "emet-hal", "emet-providers", "emet-engine"],
          "additionalProperties": {"type": "string", "minLength": 1}
        },
        "platform": {"type": "string", "pattern": "^[a-z0-9]+-[a-z0-9_]*$"},
        "python": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+"}
      },
      "additionalProperties": true
    },

    "wake": {
      "description": "The line --stats prints under a wake that handed audio to the transcriber.",
      "type": "object",
      "required": ["kind", "wake", "at_s", "confidence", "lag_ms", "heard_ms", "name_ms", "level_ms", "cut_short"],
      "properties": {
        "kind": {"const": "wake"},
        "wake": {"type": "integer", "minimum": 1},
        "at_s": {"$ref": "#/$defs/seconds"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "lag_ms": {"type": "integer", "minimum": 0},
        "heard_ms": {"type": "integer", "minimum": 0},
        "name_ms": {"type": "integer", "minimum": 0},
        "level_ms": {"type": "integer", "minimum": 0},
        "cut_short": {"type": "boolean"}
      },
      "additionalProperties": true
    },

    "turn": {
      "description": "The per-turn line: the wait from the person's last loud frame to the robot's first sound, the tokens, and what each stage sent.",
      "type": "object",
      "required": [
        "kind", "turn", "at_s", "outcome", "gap_ms",
        "tail_ms", "final_ms", "reply_first_ms", "voice_first_ms",
        "input_tokens", "output_tokens",
        "stt_audio_s", "stt_host", "llm_chars", "llm_host", "voice_chars", "voice_host",
        "sentences", "cleaned"
      ],
      "properties": {
        "kind": {"const": "turn"},
        "turn": {"type": "integer", "minimum": 1},
        "at_s": {"$ref": "#/$defs/seconds"},
        "outcome": {
          "enum": [
            "answered", "cut_at_cap", "empty_at_cap", "declined", "failed", "unavailable",
            "out_of_credit", "words_lost", "nothing_heard", "no_speech", "not_answered"
          ]
        },
        "gap_ms": {"$ref": "#/$defs/ms"},
        "tail_ms": {"$ref": "#/$defs/ms"},
        "final_ms": {"$ref": "#/$defs/ms"},
        "reply_first_ms": {"$ref": "#/$defs/ms"},
        "voice_first_ms": {"$ref": "#/$defs/ms"},
        "input_tokens": {"type": ["integer", "null"], "minimum": 0},
        "output_tokens": {"type": ["integer", "null"], "minimum": 0},
        "stt_audio_s": {"$ref": "#/$defs/seconds"},
        "stt_host": {"$ref": "#/$defs/host"},
        "llm_chars": {"$ref": "#/$defs/count"},
        "llm_host": {"$ref": "#/$defs/host"},
        "voice_chars": {"$ref": "#/$defs/count"},
        "voice_host": {"$ref": "#/$defs/host"},
        "sentences": {"$ref": "#/$defs/count"},
        "cleaned": {"$ref": "#/$defs/count"}
      },
      "additionalProperties": true
    },

    "footer": {
      "description": "The --stats footer, from frames to verdict.",
      "type": "object",
      "required": [
        "kind", "at_s", "frames", "audio_s", "wakes", "turns", "extended",
        "frame_mean_ms", "frame_p50_ms", "frame_p95_ms", "frame_max_ms",
        "budget_ms", "over_budget", "realtime", "dropped", "dropped_busy", "overflows",
        "stt_final", "llm_first", "llm_done", "voice_first", "voice_done",
        "name_cut", "turn_gap", "tokens", "sent", "cleaned", "clock", "board", "kept_up"
      ],
      "properties": {
        "kind": {"const": "footer"},
        "at_s": {"$ref": "#/$defs/seconds"},
        "frames": {"$ref": "#/$defs/count"},
        "audio_s": {"$ref": "#/$defs/seconds"},
        "wakes": {"$ref": "#/$defs/count"},
        "turns": {"$ref": "#/$defs/count"},
        "extended": {"$ref": "#/$defs/count"},
        "frame_mean_ms": {"type": "number", "minimum": 0},
        "frame_p50_ms": {"type": "number", "minimum": 0},
        "frame_p95_ms": {"type": "number", "minimum": 0},
        "frame_max_ms": {"type": "number", "minimum": 0},
        "budget_ms": {"type": "integer", "minimum": 1},
        "over_budget": {"$ref": "#/$defs/count"},
        "realtime": {"type": "number", "minimum": 0},
        "dropped": {"$ref": "#/$defs/count"},
        "dropped_busy": {"$ref": "#/$defs/count"},
        "overflows": {"type": ["integer", "null"], "minimum": 0},
        "stt_final": {"$ref": "#/$defs/latency"},
        "llm_first": {"$ref": "#/$defs/latency"},
        "llm_done": {"$ref": "#/$defs/latency"},
        "voice_first": {"$ref": "#/$defs/latency"},
        "voice_done": {
          "allOf": [{"$ref": "#/$defs/latency"}],
          "required": ["spoken", "lost"],
          "properties": {
            "spoken": {"$ref": "#/$defs/count"},
            "lost": {"$ref": "#/$defs/count"}
          }
        },
        "name_cut": {
          "type": ["object", "null"],
          "required": ["moved", "of", "mean_ms", "max_ms"],
          "properties": {
            "moved": {"$ref": "#/$defs/count"},
            "of": {"type": "integer", "minimum": 1},
            "mean_ms": {"$ref": "#/$defs/ms"},
            "max_ms": {"$ref": "#/$defs/ms"}
          },
          "additionalProperties": true
        },
        "turn_gap": {
          "type": ["object", "null"],
          "required": ["median_ms", "mean_ms", "max_ms", "n"],
          "properties": {
            "median_ms": {"type": "integer"},
            "mean_ms": {"type": "integer"},
            "max_ms": {"type": "integer"},
            "n": {"type": "integer", "minimum": 1}
          },
          "additionalProperties": true
        },
        "tokens": {
          "type": ["object", "null"],
          "required": ["in", "out", "n"],
          "properties": {
            "in": {"type": ["integer", "null"], "minimum": 0},
            "out": {"type": ["integer", "null"], "minimum": 0},
            "n": {"type": "integer", "minimum": 1}
          },
          "additionalProperties": true
        },
        "sent": {"type": "array", "items": {"$ref": "#/$defs/sent"}},
        "cleaned": {
          "type": ["object", "null"],
          "required": ["changed", "of"],
          "properties": {
            "changed": {"$ref": "#/$defs/count"},
            "of": {"type": "integer", "minimum": 1}
          },
          "additionalProperties": true
        },
        "clock": {
          "type": ["object", "null"],
          "required": ["wall_s", "audio_s", "skew_s", "skew_pct"],
          "properties": {
            "wall_s": {"$ref": "#/$defs/seconds"},
            "audio_s": {"$ref": "#/$defs/seconds"},
            "skew_s": {"type": "number"},
            "skew_pct": {"type": "number"}
          },
          "additionalProperties": true
        },
        "board": {
          "type": ["object", "null"],
          "required": ["start", "end"],
          "properties": {
            "start": {"$ref": "#/$defs/reading"},
            "end": {"$ref": "#/$defs/reading"}
          },
          "additionalProperties": true
        },
        "kept_up": {"type": "boolean"}
      },
      "additionalProperties": true
    }
  }
}
